# Versiones fijadas (sha256 en dl/SHA256SUMS y MANIFEST.txt). Bash.
MPV_VERSION=0.41.0
FFMPEG_VERSION=8.0.3
LIBPLACEBO_VERSION=7.360.1   # tag v7.360.1, commit cee9b076f2c63104ccfd497fa79c39a867293ec4 + submódulos
LIBASS_VERSION=0.17.5
FREETYPE_VERSION=2.14.3
HARFBUZZ_VERSION=14.6.0
FRIBIDI_VERSION=1.0.17
DAV1D_VERSION=1.5.4
LIBXML2_VERSION=2.15.4
UCHARDET_VERSION=0.0.8
LIBPNG_VERSION=1.6.59
MACOS_MIN=12.0
IOS_MIN=15.0
TVOS_MIN=15.0   # el mínimo que admite el SDK de tvOS 27 (SDKSettings.json)
XROS_MIN=2.0    # VideoToolbox y el render a textura; lo espacial y el cine piden 26+ en la app

FFMPEG_COMMON=(
  --disable-autodetect --disable-programs --disable-doc --disable-avdevice --disable-debug
  --enable-small --enable-pic --enable-network
  --disable-gpl --disable-nonfree --disable-version3
  --enable-avcodec --enable-avformat --enable-avfilter --enable-swresample --enable-swscale
  --disable-vulkan --disable-iconv --disable-bzlib --disable-lzma --enable-zlib
  --enable-libdav1d --enable-libxml2
  --enable-decoders --disable-decoder=truehd,mlp,vvc,eac3,dca
  --enable-parsers --enable-demuxers --enable-bsfs --enable-hwaccels --enable-protocols
  --disable-encoders --enable-encoder=png,mjpeg,ljpeg,jpegls,jpeg2000
  --disable-muxers --enable-muxer=spdif
  --disable-filters
  --enable-filter=overlay,equalizer,yadif,bwdif,scale,format,null,hwdownload,hwupload
  --enable-filter=aresample,aformat,anull,volume,pan,loudnorm,dynaudnorm,acompressor,alimiter,speechnorm
)
FFMPEG_APPLE=(
  --enable-pthreads --enable-videotoolbox --enable-audiotoolbox --enable-metal
  --enable-securetransport --enable-filter=yadif_videotoolbox
)
LIBPLACEBO_COMMIT=cee9b076f2c63104ccfd497fa79c39a867293ec4
